# =====================================================================
# SmartSpend Frontend Production Environment Variables (Vercel)
# =====================================================================

# 1. Backend API Endpoint
# Point this to your live Render backend URL (no trailing slash)
VITE_API_URL=https://your-smartspend-api.onrender.com/api

# 2. Supabase Public Config
VITE_SUPABASE_URL=https://your-project.supabase.co
# Optional public anon key (starts with eyJ... or sb_anon_)
# Leave blank to delegate all auth securely to FastAPI backend
VITE_SUPABASE_ANON_KEY=

