# =====================================================================
# SmartSpend Backend Production Environment Variables
# =====================================================================

# 1. Supabase Project Configuration
SUPABASE_URL=https://your-project.supabase.co
# Use your Supabase secret key (or service_role key)
SUPABASE_KEY=your-supabase-secret-or-service-key

# 2. Production URL & CORS Settings
# Set this to your live Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-smartspend.vercel.app
# Comma-separated allowed origins for CORS (include local dev + your Vercel domain)
ALLOWED_ORIGINS=https://your-smartspend.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# 3. Brevo Transactional Email (SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-password-or-master-key
BREVO_SENDER_EMAIL=your-verified-sender@gmail.com
BREVO_SENDER_NAME=SmartSpend
