# Supabase Project Credentials
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the anon / public key (NEVER use the service_role key in client/public code)
SUPABASE_KEY=your-supabase-anon-key

# CORS Allowed Origins (comma-separated, defaults to Vite development server)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
